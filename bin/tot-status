#!/usr/bin/env node
// tot-status — show pending branches (lines with [ ])
// Usage: tot-status [paths.txt]

const fs = require('fs');

const inputFile = process.argv[2] || 'paths.txt';

let content;
try {
  content = fs.readFileSync(inputFile, 'utf-8');
} catch (_) {
  console.log('all done ✓');
  process.exit(0);
}

const lines = content.split('\n').filter(l => l.includes('[ ]'));

if (lines.length === 0) {
  console.log('all done ✓');
} else {
  for (const line of lines) {
    console.log(line.trim());
  }
}
