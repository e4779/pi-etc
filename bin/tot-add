#!/usr/bin/env node
// tot-add — add branch to paths.txt and rebuild
// Usage: tot-add "path/branch" "comment" [paths.txt]

const fs = require('fs');
const { execSync } = require('child_process');

const branchPath = process.argv[2];
const comment = process.argv[3] || '';
const inputFile = process.argv[4] || 'paths.txt';

if (!branchPath) {
  console.error('Usage: tot-add "path/branch" "comment" [paths.txt]');
  process.exit(1);
}

// Ensure file exists
let content = '';
try {
  content = fs.readFileSync(inputFile, 'utf-8');
} catch (_) {
  // File doesn't exist, start fresh
}

// Trim trailing whitespace
const trimmed = content.replace(/\s*$/, '\n');

// Append new line
const line = branchPath + (comment ? ' # ' + comment : '');
fs.writeFileSync(inputFile, trimmed + line + '\n', 'utf-8');

// Re-run tot-tree
const binDir = __dirname;
const selfDir = binDir;
const treeScript = require('path').join(selfDir, 'tot-tree');

try {
  execSync(`node "${treeScript}" "${inputFile}"`, { stdio: 'inherit' });
} catch (_) {
  // Fallback: just run tot-tree directly
  require(treeScript);
}
