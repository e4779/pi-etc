#!/usr/bin/env node
// tot-tree — render paths.txt as ASCII tree
// Usage: tot-tree [paths.txt]

const fs = require('fs');
const path = require('path');

const inputFile = process.argv[2] || 'paths.txt';

// --- Parse lines ---
// Format: path/to/branch # optional comment [status]
function parseLine(line) {
  const trimmed = line.trim();
  if (!trimmed || trimmed.startsWith('#')) return null;

  // Split on first # to get path and rest (comment + status)
  const hashIdx = trimmed.indexOf('#');
  let rawPath, rawComment;
  if (hashIdx === -1) {
    rawPath = trimmed;
    rawComment = '';
  } else {
    rawPath = trimmed.slice(0, hashIdx).trim();
    rawComment = trimmed.slice(hashIdx + 1).trim();
  }
  if (!rawPath) return null;

  // Extract status [✓], [ ], [~], [❌] etc from end of comment
  let comment = rawComment;
  let status = '';
  const statusMatch = comment.match(/(\[[^\]]*\])\s*$/);
  if (statusMatch) {
    status = statusMatch[1];
    comment = comment.slice(0, comment.lastIndexOf(statusMatch[1])).trim();
  }

  const parts = rawPath.split('/').filter(Boolean);
  return { parts, comment, status };
}

// --- Build tree ---
function buildTree(entries) {
  const root = { name: '', children: [], comment: '', status: '', isRoot: true };

  for (const entry of entries) {
    let node = root;
    for (let i = 0; i < entry.parts.length; i++) {
      const part = entry.parts[i];
      const isLast = i === entry.parts.length - 1;
      let child = node.children.find(c => c.name === part);
      if (!child) {
        child = {
          name: part,
          children: [],
          comment: isLast ? entry.comment : '',
          status: isLast ? entry.status : '',
        };
        node.children.push(child);
      } else if (isLast) {
        // Update comment/status from the last occurrence of this leaf
        child.comment = entry.comment;
        child.status = entry.status;
      }
      node = child;
    }
  }

  return root;
}

// --- Render tree ---
function renderTree(node, prefix = '', isLast = true, isRoot = false) {
  const lines = [];

  if (isRoot) {
    // Root is a special virtual node — just render children
    for (let i = 0; i < node.children.length; i++) {
      const child = node.children[i];
      const childIsLast = i === node.children.length - 1;
      const childLines = renderTree(child, '', childIsLast, false);
      lines.push(...childLines);
    }
    return lines;
  }

  // Build the label for this node
  let label = node.name;
  if (node.comment || node.status) {
    label += ' — ' + node.comment;
    if (node.status) label += ' ' + node.status;
  }

  // Connector
  const connector = isLast ? '└── ' : '├── ';
  lines.push(prefix + connector + label);

  // Render children
  for (let i = 0; i < node.children.length; i++) {
    const child = node.children[i];
    const childIsLast = i === node.children.length - 1;
    const childPrefix = prefix + (isLast ? '    ' : '│   ');
    const childLines = renderTree(child, childPrefix, childIsLast, false);
    lines.push(...childLines);
  }

  return lines;
}

// --- Main ---
function main() {
  let content;
  try {
    content = fs.readFileSync(inputFile, 'utf-8');
  } catch (err) {
    // File doesn't exist — create empty
    fs.writeFileSync(inputFile, '', 'utf-8');
    console.log('(empty)');
    process.exit(0);
  }

  const lines = content.split('\n');
  const entries = lines.map(parseLine).filter(Boolean);

  if (entries.length === 0) {
    console.log('(empty)');
    process.exit(0);
  }

  const tree = buildTree(entries);
  const output = renderTree(tree, '', true, true);
  console.log(output.join('\n'));
}

main();
