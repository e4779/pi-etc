{
	"name": "pi-etc",
	"version": "0.1.0",
	"description": "Personal pi coding agent extensions, skills, and themes",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-skill"
	],
	"type": "module",
	"scripts": {
		"lint:skills": "for f in packages/skills/*/SKILL.md packages/*/skills/*/SKILL.md; do [ -e \"$f\" ] && npx -y skills-ref validate \"$f\" || exit 1; done && sh scripts/lint-skills-data.sh",
		"gate": "sh tools/gate.sh",
		"postinstall": "node tools/install-hooks.mjs"
	},
	"pi": {
		"extensions": [
			"./packages/whoami/index.ts",
			"./packages/shell-gate/index.ts",
			"./packages/co-author/index.ts"
		],
		"skills": [
			"./packages/skills/drawio",
			"./packages/skills/mindmap",
			"./packages/skills/skill-author",
			"./packages/skills/gh-cli",
			"./packages/skills/mcpls",
			"./packages/skills/mcporter",
			"./packages/skills/chrome-devtools",
			"./packages/skills/grill",
			"./packages/skills/layout-check",
			"./packages/skills/opensource-contribution",
			"./packages/skills/shell-taste",
			"./packages/skills/sobesednik",
			"./packages/skills/zai-mcp",
			"./packages/pi-recall/skills/pi-recall"
		]
	},
	"author": "e41q",
	"license": "ISC",
	"dependencies": {
		"diff": "^5.2.0",
		"nano-staged": "^1.0.2",
		"shellcheck-wasm": "^0.3.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.84.4",
		"typescript": "^5.8.3"
	},
	"private": true,
	"workspaces": [
		"packages/*",
		"apps/*"
	]
}
