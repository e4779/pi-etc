{
  "name": "pi-etc",
  "version": "0.1.0",
  "description": "Personal pi coding agent extensions, skills, and themes",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill"
  ],
  "type": "module",
  "scripts": {
    "lint:skills": "for f in skills/*/SKILL.md; do npx -y skills-ref validate \"$f\" || exit 1; done"
  },
  "pi": {
    "extensions": [
      "./extensions/qwen/index.ts",
      "./extensions/lint-check/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "author": "e41q",
  "license": "ISC",
  "dependencies": {
    "diff": "^5.2.0",
    "nano-staged": "^1.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "typescript": "^5.8.3"
  }
}
